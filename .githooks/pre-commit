#!/usr/bin/env bash
# FAST gate (<10s on the common python-only path). Blocks the commit; never
# stages or unstages anything itself. See CONTRIBUTING.md -> "Local Gates".
set -o pipefail
_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$_DIR/lib/common.sh"
. "$_DIR/lib/checks.sh"

if hook_honor_global_skip "pre-commit"; then exit 0; fi

check_snapshot || exit 1

rc=0
quality_args=(--python-only)
if git diff --cached --name-only | grep -Eq '^ui-tui/'; then
  if [ -n "${HERMES_HOOKS_SKIP_TSC:-}" ]; then
    hook_warn "TypeScript checks SKIPPED (HERMES_HOOKS_SKIP_TSC set)."
    hook_log_skip "pre-commit" "typescript" "${HERMES_HOOKS_SKIP_TSC}"
  else
    quality_args=()
  fi
fi
hook_note "pre-commit: shared quality gates..."
if ! check_quality "${quality_args[@]}"; then
  hook_fail "Quality checks failed" "Local Gates" "Run: python3 scripts/dev.py check"
  rc=1
fi
if ! check_drift cached; then rc=1; fi
if ! check_snapshot; then rc=1; fi
if [ "$rc" -ne 0 ]; then
  hook_warn "pre-commit blocked the commit. The hook staged/unstaged nothing."
fi
exit "$rc"
