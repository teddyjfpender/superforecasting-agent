#!/usr/bin/env bash
# HEAVIER gate (bounded ~2-3min): targeted pytest for the changed python
# domains, vitest --changed for the TUI, and the codegen staleness check again.
# git feeds us "<local ref> <local sha> <remote ref> <remote sha>" on stdin.
# See CONTRIBUTING.md -> "Commit provenance" and "Local Gates".
set -o pipefail
_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$_DIR/lib/common.sh"
. "$_DIR/lib/checks.sh"

if hook_honor_global_skip "pre-push"; then exit 0; fi

Z40="0000000000000000000000000000000000000000"
base=""
head="HEAD"
has_updates=0
bases=()
while read -r localref localsha remoteref remotesha; do
  [ -z "$localsha" ] && continue
  [ "$localsha" = "$Z40" ] && continue          # branch deletion, nothing to test
  check_snapshot --ref "$localsha" || exit 1
  has_updates=1
  head="$localsha"
  if [ "$remotesha" = "$Z40" ] || [ -z "$remotesha" ]; then
    base="$(git merge-base origin/main "$localsha" 2>/dev/null \
            || git rev-parse "$localsha^" 2>/dev/null || echo "$localsha")"
  else
    base="$remotesha"
  fi
  bases+=("$base")
done
[ "$has_updates" -eq 0 ] && exit 0

rc=0
for base in "${bases[@]}"; do

# Same blocking quality implementation as pre-commit and CI.
quality_args=(--python-only)
if git diff --name-only "$base" "$head" | grep -Eq '^ui-tui/'; then
  quality_args=()
fi
if ! check_quality "${quality_args[@]}"; then
  hook_fail "Quality checks failed" "Local Gates" "Run: python3 scripts/dev.py check"
  rc=1
fi

# targeted pytest for the changed python domains
TARGETS=""
while IFS= read -r t; do [ -n "$t" ] && TARGETS="$TARGETS $t"; done < <(py_test_targets "$base" "$head")
if [ -n "$TARGETS" ]; then
  hook_note "pre-push: pytest$TARGETS"
  # shellcheck disable=SC2086
  if ! "$HOOKS_REPO_ROOT/scripts/run_tests.sh" $TARGETS -q; then
    hook_fail "Tests failed for a changed domain" "Commit provenance (tests green BEFORE you push)" \
      "Reproduce: scripts/run_tests.sh$TARGETS"
    rc=1
  fi
else
  hook_note "pre-push: no python domain mapped to the changed files -- skipping targeted pytest."
fi

# vitest --changed when ui-tui was touched
if git diff --name-only "$base" "$head" | grep -Eq '^ui-tui/'; then
  hook_note "pre-push: vitest --changed (ui-tui touched)..."
  if ! check_vitest_changed "$base"; then
    hook_fail "TUI tests failed" "Commit provenance" "Reproduce: ( cd ui-tui && npm test )"
    rc=1
  fi
fi

done
if ! check_snapshot --ref "$head"; then rc=1; fi
exit "$rc"
