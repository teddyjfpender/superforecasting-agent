# ...except the two-line module marker. entry.js is an ES module, and without a
# "type" beside it Node walks UP to the repo-root package.json (which has no
# "type"), prints a 4-line MODULE_TYPELESS_PACKAGE_JSON warning to stderr before
# first paint, and reparses the bundle as ESM anyway. The marker is a tracked
# source file, not a build artifact, so it must survive the ignore above.
!superforecasting_agent/runtime/tui_dist/package.json
superforecasting_agent/runtime/scripts/
docs/superpowers/*

# Standalone terminal package build input (generated by build_profiles.py).
products/tui/superforecasting_agent_tui/dist/
products/tui/dist/
