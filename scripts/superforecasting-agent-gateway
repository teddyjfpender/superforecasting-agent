#!/usr/bin/env python3
"""Fork-native standalone gateway launcher.

This keeps the optional messaging gateway available without asking new
operators to invoke a Hermes-branded script name.
"""

from __future__ import annotations

from pathlib import Path
import runpy


if __name__ == "__main__":
    runpy.run_path(str(Path(__file__).with_name("hermes-gateway")), run_name="__main__")
