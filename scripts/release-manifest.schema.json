{
  "$id": "https://github.com/teddyjfpender/superforecasting-agent/release-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "size_bytes": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "name",
          "sha256",
          "size_bytes"
        ],
        "type": "object"
      },
      "minProperties": 4,
      "required": [
        "wheel",
        "sdist",
        "installer",
        "checksums"
      ],
      "type": "object"
    },
    "git": {
      "additionalProperties": false,
      "properties": {
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "commit": {
          "pattern": "^[0-9a-f]{7,40}$",
          "type": "string"
        }
      },
      "required": [
        "commit"
      ],
      "type": "object"
    },
    "image": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "platforms": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "registry": {
          "minLength": 1,
          "type": "string"
        },
        "repository": {
          "minLength": 1,
          "type": "string"
        },
        "tags": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "registry",
        "repository",
        "tags",
        "platforms",
        "digest"
      ],
      "type": "object"
    },
    "min_migration_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "type": "string"
    },
    "product": {
      "const": "superforecasting-agent"
    },
    "released": {
      "format": "date-time",
      "type": "string"
    },
    "schema_version": {
      "const": "1"
    },
    "tag": {
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
      "type": "string"
    },
    "version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "product",
    "version",
    "tag",
    "released",
    "min_migration_version",
    "git",
    "artifacts",
    "image"
  ],
  "title": "Superforecasting Agent release manifest",
  "type": "object"
}
