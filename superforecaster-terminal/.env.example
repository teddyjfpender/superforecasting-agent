# Enable the terminal UI backend overlay. Without this, the UI uses local mock data.
VITE_TERMD_API_ENABLED=1
VITE_TERMD_SYMBOLS=SPX,INDU,CCMP,RTY,NYA,SOX,VIX,DXY,MOVE,XLK,XLF,XLE,XLV,XLY,XLP,XLI,XLU,XLB,XLRE,XLC,CL1,CO1,XAU,XAG,NG1,HG1,LA1,HO1,RB1,XPT,XPD,C 1,W 1,S 1,SB1,KC1,CC1,CT1,BTC,ETH,SOL,XRP,BNB,ADA,DOGE,AVAX,LINK,US02Y,US05Y,US10Y,US30Y,NVDA,AAPL,MSFT,GOOGL,AMZN,META,AVGO,AMD,ORCL,CRM,ADBE,CSCO,JPM,BAC,WFC,GS,MS,BRK/B,V,MA,AXP,XOM,CVX,COP,SLB,UNH,JNJ,LLY,PFE,MRK,ABBV,TMO,TSLA,HD,MCD,NKE,SBUX,WMT,PG,KO,PEP,COST,BA,CAT,GE,HON,UNP,DIS,NFLX,T,VZ,CMCSA,NEE,DUK,SO,LIN,FCX,NEM,AMT,PLD,CCI
VITE_TERMD_MACRO_SERIES=fred.DGS10,bis.US_POLICY_RATE,bls.LNS14000000,bea.PCEPI
# Comma-separated list of prediction venues to poll in parallel. F4 PRED merges them.
VITE_TERMD_PREDICTION_VENUE=polymarket,kalshi
VITE_TERMD_API_POLL_MS=5000

# Preferred local-dev path: Vite proxies /termd-api to the edge and injects
# Authorization server-side, so the JWT is not exposed to browser code.
TERMD_API_BASE_URL=http://178.105.127.196:8080
TERMD_API_TOKEN=

# Vercel production path: serverless /api/termd proxies to TERMD_API_BASE_URL
# and injects TERMD_API_TOKEN server-side. Set this as a Vercel build env var.
# VITE_TERMD_API_BASE_URL=/api/termd

# Direct browser mode is also supported for deployments with CORS configured.
# VITE_TERMD_API_BASE_URL=http://178.105.127.196:8080
# VITE_TERMD_API_TOKEN=
